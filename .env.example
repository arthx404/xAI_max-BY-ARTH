# ─────────────────────────────────────────────────────────────
#  xAI Max — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Get your free NVIDIA API key at: https://build.nvidia.com
# Key format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=nvapi-your-key-here

# Server port (default: 3000)
PORT=3000

# Allowed origin for CORS (use * for development)
CORS_ORIGIN=http://localhost:3000

# Rate limiting — requests per 15 minutes per IP
RATE_LIMIT=100

# Optional Supabase configuration for Google sign-in and persistent workspaces.
# Keep the service role key server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
